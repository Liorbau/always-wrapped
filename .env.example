# Copy to .env and fill in. Never commit .env.

# Spotify app (developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Postgres (Supabase) — omit to use local SQLite
DATABASE_URL=postgresql://user:password@host:5432/postgres

# LLM provider for the agents (default: openai)
LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o            # optional override
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...       # if LLM_PROVIDER=anthropic
# GOOGLE_API_KEY=...          # if LLM_PROVIDER=google
# ROUTER_MODEL=gpt-4o-mini    # optional cheaper model for chat routing

# Agent spend cap per day in USD (default 20.00)
# AGENT_DAILY_BUDGET_USD=20.00

# Deployed push token (contents of local .cache-push) so headless hosts can push approved playlists without a browser login.
# SPOTIFY_PUSH_CACHE_CONTENT=

# Planner agent (calendar -> playlists -> Telegram approval). All optional;
# the Planner is disabled until CALENDAR_ICS_URL + the Telegram vars are set.
# Private .ics feed from Google/Apple Calendar (Settings -> secret address).
# CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics
# Telegram bot from @BotFather; chat id from @userinfobot (your own DM).
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# Shared secret Telegram echoes back on every webhook call (any random string).
# TELEGRAM_WEBHOOK_SECRET=some_long_random_string
# Timezone for /timer schedules (default Asia/Jerusalem).
# USER_TZ=Asia/Jerusalem

